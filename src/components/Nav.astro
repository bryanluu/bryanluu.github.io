---
import '../styles/custom.scss';
import 'bootstrap-icons/font/bootstrap-icons.css';
import Avatar from '../components/Avatar.jsx';
---
<style>
  .profile-pic {
    border-radius: 50%;
    border: 5px solid var(--bs-primary);
    width: 200px;
  }

  .profile-pic-mini {
    border-radius: 50%;
    border: 1px solid var(--bs-light);
    width: 32px;
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  .navbar-brand:hover > .profile-pic-mini {
    border: 1px solid var(--bs-light-text-emphasis);
  }

  nav {
    width: 100%;
    padding: 1em;
  }

  .nav, .navbar, .nav-pills, .nav-underline {
    --bs-nav-link-color: var(--bs-light);
    --bs-nav-link-hover-color: var(--bs-light-text-emphasis);
    --bs-nav-link-font-size: 1.1rem;
    --bs-navbar-brand-color: var(--bs-light);
    --bs-navbar-brand-hover-color: var(--bs-light-text-emphasis);
    --bs-nav-pills-link-active-color: var(--bs-light);
    --bs-nav-pills-link-active-bg: var(--bs-primary-bg-subtle);
    --bs-nav-underline-link-active-color: var(--bs-light);
  }

</style>
<nav class="navbar bg-primary mb-4 border-bottom no-print">
  <a href="/" class="navbar-brand d-flex align-items-center gap-2 mb-3 mb-md-0 me-md-auto text-decoration-none">
    <Avatar src="/assets/profile_pic.jpg" alt="Photo of me wearing a hat, with a cat on it" size={32} style={{borderWidth: "1px", borderStyle: "solid"}} />
    <span class="fs-4">Bryan L. Luu</span>
  </a>
  <ul class="nav nav-pills">
    <li class="nav-item"><a href="/index.html" class="nav-link">Home</a></li>
    <!-- The link below won't work locally because it links to the resume repo -->
    <li class="nav-item"><a href="/resume/resume.pdf" class="nav-link">Resumé</a></li>
    <!-- <li class="nav-item"><a href="/public/projects.html" class="nav-link">Projects</a></li> -->
  </ul>
</nav>