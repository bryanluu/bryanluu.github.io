---
import { Image } from "astro:assets";

const { src, alt, caption = alt, raw = false, col = "md-6" } = Astro.props;
---

<div class={`col-${col}`}>
  {
    raw ? (
      <img src={src.src} alt={alt} loading="lazy" class="img-fluid rounded-3 border" />
    ) : (
      <Image src={src} alt={alt} inferSize class="img-fluid rounded-3 border" />
    )
  }
  <p class="text-secondary small mt-1 mb-0">{caption}</p>
</div>
