---
import { Image } from "astro:assets";

const {
  src,
  alt,
  caption = alt,
  raw = false,
  figureClass = "mb-3",
  imgClass = "img-fluid rounded-3 border",
  style,
} = Astro.props;
---

<figure class={figureClass}>
  {
    raw ? (
      <img src={src.src} alt={alt} loading="lazy" class={imgClass} style={style} />
    ) : (
      <Image src={src} alt={alt} inferSize class={imgClass} style={style} />
    )
  }
  <figcaption class="text-secondary small mt-1 mb-0">{caption}</figcaption>
</figure>
