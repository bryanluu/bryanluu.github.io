---
import MainLayout from "../layouts/MainLayout.astro";
import Avatar from "../components/About/Avatar";
import CTABanner from "../components/CTABanner";

const avatarSize = 200;
const topBannerHeight = `${avatarSize / 2 + 48}px`;
---

<style define:vars={{ avatarSize, topBannerHeight }}>
  #top-banner {
    position: absolute;
    top: 63px;
    height: var(--topBannerHeight);
    width: 100%;
    background-color: var(--bs-primary-bg-subtle);
    z-index: -1;
  }

  #hero {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    row-gap: 1rem;
  }

  #hero > :global(.avatar) {
    grid-column: 1;
    grid-row: 1;
  }

  #hero > #hero-text {
    grid-column: 1;
    grid-row: 2;
    text-align: center;
  }

  @media (min-width: 992px) {
    #hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      row-gap: 0;
    }

    #hero > :global(.avatar) {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
      justify-self: left;
    }

    #hero > #hero-text {
      grid-column: 1 / 2;
      grid-row: 1;
      justify-self: right;
      padding-right: 1em;
      text-align: left;
    }
  }
</style>
<MainLayout title="About">
  <section>
    <div id="top-banner"></div>
    <div class="container mt-5">
      <div id="hero">
        <Avatar
          src="/assets/profile_pic.jpg"
          alt="Photo of me, wearing a hat with a cat on it"
          size={avatarSize}
          className="avatar"
        />
        <div id="hero-text">
          <h1 id="heading" class="display-4 fw-bold text-primary-emphasis mb-1">
            Hi, I'm <span class="text-primary">Bryan</span>.
          </h1>
          <p id="lead" class="lead text-body-secondary mb-0">
            As software-focused engineering physicist,
          </p>
          <p
            id="subheading"
            class="about-hero-intro text-center text-lg-start mb-0"
          >
            I am a technical professional that wears many hats. 🤠
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container my-5">
    <div class="bg-primary-subtle rounded-4 p-3 p-md-4">
      <div class="card rounded-4 p-4 mb-3">
        <div class="d-flex align-items-baseline gap-2 mb-1">
          <span class="fs-3" aria-hidden="true">🧑🏻‍💻</span>
          <h3 class="fs-4 mb-0">I am a software developer</h3>
        </div>
        <h4 class="fs-5 fw-normal text-body-secondary mb-3">
          I write code as a profession.
        </h4>
        <p>
          I've worked as a <strong>full-stack developer</strong> for over 2 years,
          building scalable web applications. I learned the ropes creating data products
          with <a
            href="https://opentech.eco/"
            class="link-underline link-underline-opacity-0 link-underline-opacity-100-hover"
            target="_blank"
            rel="noopener noreferrer">OPEN Technologies</a
          > and interactive forms with <a
            href="https://proofgov.com/"
            class="link-underline link-underline-opacity-0 link-underline-opacity-100-hover"
            target="_blank"
            rel="noopener noreferrer">Proof</a
          >.
        </p>
        <p>
          I've worked as an independent <strong>application developer</strong> in
          research laboratories, building essential software for researchers to interface
          with experimental apparatus and data.
        </p>
        <p class="mb-0">
          I've acted as a <strong>game developer</strong> in my spare time, building
          hobby projects such as <a
            href="/work/grid-arcade/"
            class="link-underline link-underline-opacity-0 link-underline-opacity-100-hover"
            >GRID</a
          >, a mini-arcade which I developed from scratch, and <a
            href="https://github.com/bryanluu/a-maze-ing-race-web"
            class="link-underline link-underline-opacity-0 link-underline-opacity-100-hover"
            target="_blank"
            rel="noopener noreferrer">A-Maze-ing Race</a
          >, a web port of a hardware project.
        </p>
      </div>

      <div class="card rounded-4 p-4 mb-3">
        <div class="d-flex align-items-baseline gap-2 mb-1">
          <span class="fs-3" aria-hidden="true">👷🏻</span>
          <h3 class="fs-4 mb-0">I am an engineering physicist</h3>
        </div>
        <h4 class="fs-5 fw-normal text-body-secondary mb-3">
          I understand systems and how they work.
        </h4>
        <p>
          <b>I'm not afraid of hard problems</b>; I've studied as a physicist in
          quantum mechanics, mechatronics, and statistical mathematics.
        </p>
        <p>
          <b>I thrive on experimentation</b>: I've iterated laser conversion
          setups, prototyped robotic sailboats, and tinkered with games.
        </p>
        <p class="mb-0">
          <b>I'm grounded in simulation</b>: I've modelled electric grid power
          flow, bird flocking behaviour, and planetary formations.
        </p>
      </div>

      <div class="card rounded-4 p-4 mb-0">
        <div class="d-flex align-items-baseline gap-2 mb-1">
          <span class="fs-3" aria-hidden="true">👨🏻‍🌾</span>
          <h3 class="fs-4 mb-0">I am a steward for good tech</h3>
        </div>
        <h4 class="fs-5 fw-normal text-body-secondary mb-3">
          I care deeply about my impact.
        </h4>
        <p>
          <b>I love to grow</b>: I've shifted my career towards climate tech,
          educating myself thoroughly on the field and completed certificates to
          prove it.
        </p>
        <p>
          <b>I'm keen to contribute</b>: I've added to new tech stacks right
          away, delivered workshops on climate policies, and led on team
          projects.
        </p>
        <p class="mb-0">
          <b>I value learning</b>: I provide and take on mentorship continually,
          I've taught for a decade to transfer my skills to others, and I'm
          still learning.
        </p>
      </div>
    </div>

    <p class="text-center mt-4 mb-0">
      Want to learn more?{" "}
      <a
        href="https://bryanluu.github.io/resume/resume.pdf"
        class="link-underline link-underline-opacity-0 link-underline-opacity-100-hover"
        target="_blank"
        rel="noopener noreferrer">Dive deeper</a
      > into my resumé 🤿
    </p>
  </section>

  <div class="bg-secondary-subtle">
    <CTABanner />
  </div>
</MainLayout>
